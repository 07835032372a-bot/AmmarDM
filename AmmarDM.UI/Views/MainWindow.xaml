<Window x:Class="AmmarDM.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ammar DM"
        Icon="/Resources/app_icon.ico"
        Height="620" Width="1000"
        MinHeight="450" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F0F0F0">

    <DockPanel LastChildFill="True">

        <!-- 1. شريط القوائم العلوي Menu -->
        <Menu DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#DCDCDC" BorderThickness="0,0,0,1" Padding="2">
            <MenuItem Header="مهام">
                <MenuItem Header="إضافة تحميل جديد" Command="{Binding AddDownloadCommand}"/>
                <MenuItem Header="استئناف الكل" Command="{Binding ResumeAllCommand}"/>
                <MenuItem Header="إيقاف الكل" Command="{Binding PauseAllCommand}"/>
                <Separator/>
                <MenuItem Header="مسح المكتملة" Command="{Binding ClearCompletedCommand}"/>
                <Separator/>
                <MenuItem Header="خروج" Click="CloseMenu_Click"/>
            </MenuItem>
            <MenuItem Header="خيارات" Command="{Binding SettingsCommand}"/>
            <MenuItem Header="تكامل المتصفحات">
                <MenuItem Header="🌐 تثبيت إضافة المتصفح (Chrome / Edge / Brave)..." Click="InstallExtension_Click"/>
                <MenuItem Header="📂 فتح مجلد إضافة المتصفح" Click="OpenExtensionFolder_Click"/>
            </MenuItem>
            <MenuItem Header="تعليمات">
                <MenuItem Header="🔄 التحقق من وجود تحديثات..." Click="CheckUpdatesMenu_Click"/>
                <Separator/>
                <MenuItem Header="حول البرنامج" Click="AboutMenu_Click"/>
            </MenuItem>
        </Menu>

        <!-- 2. شريط الأدوات Toolbar -->
        <ToolBarTray DockPanel.Dock="Top" Background="#EFEFEF">
            <ToolBar Background="#EFEFEF" ToolBarTray.IsLocked="True" Loaded="ToolBar_Loaded">
                <Button Command="{Binding AddDownloadCommand}" Style="{StaticResource IDMToolbarButton}" ToolTip="إضافة رابط جديد">
                    <StackPanel Orientation="Vertical" Width="60" HorizontalAlignment="Center">
                        <TextBlock Text="➕" FontSize="18" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                        <TextBlock Text="إضافة رابط" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ResumeCommand}" Style="{StaticResource IDMToolbarButton}" ToolTip="استئناف التحميل المحدد">
                    <StackPanel Orientation="Vertical" Width="55" HorizontalAlignment="Center">
                        <TextBlock Text="▶" FontSize="18" Foreground="#1565C0" HorizontalAlignment="Center"/>
                        <TextBlock Text="استئناف" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding PauseCommand}" Style="{StaticResource IDMToolbarButton}" ToolTip="إيقاف التحميل المحدد">
                    <StackPanel Orientation="Vertical" Width="55" HorizontalAlignment="Center">
                        <TextBlock Text="⏸" FontSize="18" Foreground="#C62828" HorizontalAlignment="Center"/>
                        <TextBlock Text="إيقاف" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding PauseAllCommand}" Style="{StaticResource IDMToolbarButton}" ToolTip="إيقاف جميع التحميلات">
                    <StackPanel Orientation="Vertical" Width="60" HorizontalAlignment="Center">
                        <TextBlock Text="⏹" FontSize="18" Foreground="#E65100" HorizontalAlignment="Center"/>
                        <TextBlock Text="إيقاف الكل" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Separator Margin="4,4"/>

                <Button Command="{Binding DeleteCommand}" Style="{StaticResource IDMToolbarButton}" ToolTip="حذف التحميل المحدد">
                    <StackPanel Orientation="Vertical" Width="55" HorizontalAlignment="Center">
                        <TextBlock Text="❌" FontSize="16" Foreground="#D32F2F" HorizontalAlignment="Center"/>
                        <TextBlock Text="حذف" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ClearCompletedCommand}" Style="{StaticResource IDMToolbarButton}" ToolTip="مسح التحميلات المكتملة">
                    <StackPanel Orientation="Vertical" Width="65" HorizontalAlignment="Center">
                        <TextBlock Text="🧹" FontSize="16" Foreground="#546E7A" HorizontalAlignment="Center"/>
                        <TextBlock Text="مسح المكتمل" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Separator Margin="4,4"/>

                <Button Command="{Binding SettingsCommand}" Style="{StaticResource IDMToolbarButton}" ToolTip="خيارات البرنامج">
                    <StackPanel Orientation="Vertical" Width="55" HorizontalAlignment="Center">
                        <TextBlock Text="⚙" FontSize="18" Foreground="#37474F" HorizontalAlignment="Center"/>
                        <TextBlock Text="خيارات" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- 3. شريط الحالة السفلي StatusBar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Height="24">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#424242"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Left">
                <TextBlock Text="المطور: عمار الصميدعي | Ammar DM" FontSize="11" Foreground="#616161"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 4. محتوى البرنامج: الشجرة الجانبية + جدول التحميلات -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="140" MaxWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- الشجرة الجانبية Categories -->
            <Border Grid.Column="0" Background="White" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                <TreeView BorderThickness="0" Background="Transparent" Margin="2">
                    <TreeViewItem Header="الفئات" IsExpanded="True">
                        <TreeViewItem Header="جميع التحميلات" IsSelected="True"/>
                        <TreeViewItem Header="غير مكتملة"/>
                        <TreeViewItem Header="مكتملة"/>
                        <TreeViewItem Header="فيديو"/>
                        <TreeViewItem Header="صوتيات وموسيقى"/>
                        <TreeViewItem Header="مستندات"/>
                        <TreeViewItem Header="برامج"/>
                        <TreeViewItem Header="ملفات مضغوطة"/>
                    </TreeViewItem>
                </TreeView>
            </Border>

            <!-- فاصل قابل للسحب GridSplitter -->
            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#D5D5D5"/>

            <!-- جدول التحميلات DataGrid -->
            <DataGrid Grid.Column="2"
                      ItemsSource="{Binding Downloads}"
                      SelectedItem="{Binding SelectedItem}"
                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E8E8E8"
                      Background="White"
                      BorderThickness="0"
                      SelectionMode="Single"
                      RowHeight="26"
                      FontSize="12">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="تشغيل / استئناف" Command="{Binding ResumeCommand}"/>
                        <MenuItem Header="إيقاف مؤقت" Command="{Binding PauseCommand}"/>
                        <MenuItem Header="فتح الملف" Command="{Binding OpenFileCommand}"/>
                        <MenuItem Header="فتح المجلد" Command="{Binding OpenFolderCommand}"/>
                        <Separator/>
                        <MenuItem Header="🔄 تحديث رابط التحميل (Refresh URL)..." Click="UpdateUrlMenu_Click"/>
                        <MenuItem Header="📋 خصائص الملف..." Click="PropertiesMenu_Click"/>
                        <Separator/>
                        <MenuItem Header="حذف" Command="{Binding DeleteCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم الملف" Binding="{Binding FileName}" Width="220"/>
                    <DataGridTextColumn Header="الحجم" Binding="{Binding FileSizeDisplay}" Width="85"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusDisplay}" Width="95"/>
                    <DataGridTemplateColumn Header="التقدم" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="14"
                                                 Foreground="#388E3C" Background="#E0E0E0" BorderThickness="1" BorderBrush="#BDBDBD"/>
                                    <TextBlock Text="{Binding Progress, StringFormat={}{0:F1}%}"
                                               FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="#212121"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="السرعة" Binding="{Binding SpeedDisplay}" Width="90"/>
                    <DataGridTextColumn Header="الوقت المتبقي" Binding="{Binding EtaDisplay}" Width="90"/>
                    <DataGridTextColumn Header="تم تحميله" Binding="{Binding DownloadedDisplay}" Width="90"/>
                    <DataGridTextColumn Header="الرابط الأصلي" Binding="{Binding Url}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
