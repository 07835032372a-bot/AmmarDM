<Window x:Class="AmmarDM.UI.Views.UpdateUrlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تحديث رابط التحميل - Ammar DM"
        Height="360" Width="520"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F5F5F5"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. شريط التنبيه التوجيهي كما في IDM -->
        <Border Grid.Row="0" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="🔄 وضع مراقبة واقتناص الرابط الجديد (IDM Link Catcher):" FontWeight="Bold" FontSize="11" Foreground="#B78103"/>
                <TextBlock Text="1. اضغط على 'فتح صفحة التحميل في المتصفح'." FontSize="11" Foreground="#4E342E" Margin="0,3,0,0"/>
                <TextBlock Text="2. اذهب إلى زر التحميل في الموقع واضغط عليه أو انسخ رابطه الجديد." FontSize="11" Foreground="#4E342E" Margin="0,2,0,0"/>
                <TextBlock Text="3. سيقوم Ammar DM بالتقاط الرابط الجديد تلقائياً دون الحاجة للصقه يدوياً!" FontSize="11" Foreground="#1B5E20" FontWeight="SemiBold" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- 2. زر فتح صفحة التحميل في المتصفح وحالة المراقبة -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="MonitoringIndicator" Text="🟢" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="MonitoringText" Text="جاري مراقبة الحافظة والروابط الجديدة تلقائياً..." FontSize="11" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="الملف المستهدف: " FontSize="10" Foreground="#757575" Margin="0,3,0,0"/>
                    <TextBlock x:Name="FileNameTarget" FontSize="10" FontWeight="SemiBold" Foreground="#212121" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" Content="🌐 فتح في المتصفح" Height="28" Padding="10,0" Margin="8,0,0,0" Click="OpenInBrowserBtn_Click"/>
            </Grid>
        </Border>

        <!-- 3. الحقل اليدوي للرابط في حال أراد المستخدم نسخه يدوياً -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="أو يمكنك إدخال الرابط الجديد يدوياً هنا:" FontSize="11" Foreground="#444" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="65"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewUrlTextBox" Height="26" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="لصق" Height="26" Click="PasteBtn_Click"/>
            </Grid>
            <TextBlock x:Name="StatusLabel" FontSize="11" Foreground="#C62828"/>
        </StackPanel>

        <!-- 4. أزرار التحكم -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button x:Name="OkBtn" Content="تحديث واستئناف" Width="110" Height="28" Margin="0,0,8,0" FontWeight="Bold" Click="OkBtn_Click"/>
            <Button Content="إلغاء الأمر" Width="80" Height="28" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
