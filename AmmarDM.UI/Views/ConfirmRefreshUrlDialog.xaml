<Window x:Class="AmmarDM.UI.Views.ConfirmRefreshUrlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تأكيد تطابق الملف - Ammar DM"
        Height="270" Width="490"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F5F5F5"
        ResizeMode="NoResize">

    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎯" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="تم التقاط رابط تنزيل جديد من المتصفح!" FontWeight="Bold" FontSize="13" Foreground="#1565C0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="هل هذا هو الملف المطلوب تحديثه واستئنافه؟" FontSize="11" Foreground="#555" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="الملف الأصلي:" FontSize="11" Foreground="#555" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="OriginalFileNameText" FontWeight="Bold" FontSize="11" Foreground="#111" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="الملف المكتشف:" FontSize="11" Foreground="#555" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetectedFileNameText" FontWeight="Bold" FontSize="11" Foreground="#2E7D32" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="حجم الملف:" FontSize="11" Foreground="#555" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SizeComparisonText" FontSize="11" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="الرابط المقتنص:" FontSize="11" Foreground="#555" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CapturedUrlText" FontSize="10" Foreground="#1565C0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button x:Name="YesBtn" Content="نعم، هو نفس الملف (استئناف)" Width="170" Height="28" Margin="0,0,8,0" FontWeight="Bold" Click="YesBtn_Click"/>
            <Button x:Name="NoBtn" Content="لا، ليس هو (تجاهل)" Width="120" Height="28" Margin="0,0,8,0" Click="NoBtn_Click"/>
            <Button Content="إلغاء الأمر" Width="75" Height="28" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
