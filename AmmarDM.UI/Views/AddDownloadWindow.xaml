<Window x:Class="AmmarDM.UI.Views.AddDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تحميل جديد - Ammar DM"
        Height="270" Width="480"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F0F0F0"
        ResizeMode="NoResize">

    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="أدخل عنوان الرابط الذي ترغب في تحميله:" FontSize="12" Foreground="#333" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="65"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="العنوان:" VerticalAlignment="Center" FontSize="11" Foreground="#444"/>
                <TextBox Grid.Column="1" x:Name="UrlTextBox" Height="25" VerticalContentAlignment="Center" Margin="0,0,6,0" TextChanged="UrlTextBox_TextChanged"/>
                <Button Grid.Column="2" Content="لصق" Height="25" Click="PasteBtn_Click"/>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="اسم الملف:" VerticalAlignment="Center" FontSize="11" Foreground="#444"/>
                <TextBox Grid.Column="1" x:Name="FileNameTextBox" Height="25" VerticalContentAlignment="Center"/>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="65"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="حفظ في:" VerticalAlignment="Center" FontSize="11" Foreground="#444"/>
                <TextBox Grid.Column="1" x:Name="SavePathTextBox" Height="25" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                <Button Grid.Column="2" Content="تصفح..." Height="25" Click="BrowseBtn_Click"/>
            </Grid>

            <TextBlock x:Name="StatusLabel" Foreground="#C62828" FontSize="11" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="بدء التحميل" Width="100" Height="28" Margin="0,0,8,0" FontWeight="Bold" Click="StartBtn_Click"/>
            <Button Content="التحميل لاحقاً" Width="95" Height="28" Margin="0,0,8,0" Click="DownloadLaterBtn_Click"/>
            <Button Content="إلغاء الأمر" Width="80" Height="28" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
