<Window x:Class="AmmarDM.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="خيارات Ammar DM"
        Height="420" Width="480"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F0F0F0"
        ResizeMode="NoResize">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="عام">
                <StackPanel Margin="10">
                    <CheckBox x:Name="StartWithWindowsCheckBox" Content="تشغيل Ammar DM تلقائياً مع بدء تشغيل ويندوز" Margin="0,0,0,10"/>
                    <CheckBox x:Name="ShowNotifyCheckBox" Content="إظهار إشعار اكتمال التحميل" IsChecked="True" Margin="0,0,0,10"/>
                    <CheckBox x:Name="PlaySoundCheckBox" Content="تشغيل صوت تنبيه عند اكتمال التحميل" IsChecked="True" Margin="0,0,0,16"/>

                    <GroupBox Header="مجلد الحفظ الافتراضي" Margin="0,0,0,10">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="DefaultSavePathTextBox" Height="24" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="استعراض..." Height="24" Click="BrowseBtn_Click"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="الاتصال">
                <StackPanel Margin="10">
                    <GroupBox Header="أقصى عدد للاتصالات المتزامنة" Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <TextBlock Text="الخيوط المتزامنة للملف الواحد:" Margin="0,0,0,6"/>
                            <ComboBox x:Name="DefaultConnectionsComboBox" Height="25">
                                <ComboBoxItem Content="4 اتصالات"/>
                                <ComboBoxItem Content="8 اتصالات"/>
                                <ComboBoxItem Content="16 اتصال (افتراضي)"/>
                                <ComboBoxItem Content="32 اتصال (أقصى سرعة)"/>
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="قائمة الانتظار">
                        <StackPanel Margin="6">
                            <TextBlock Text="أقصى عدد ملفات يتم تحميلها في نفس الوقت:" Margin="0,0,0,6"/>
                            <ComboBox x:Name="MaxConcurrentComboBox" Height="25">
                                <ComboBoxItem Content="1 ملف"/>
                                <ComboBoxItem Content="2 ملفين"/>
                                <ComboBoxItem Content="3 ملفات (افتراضي)"/>
                                <ComboBoxItem Content="5 ملفات"/>
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="تكامل المتصفحات (IDM)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="CaptureDownloadsCheckBox" Content="تفعيل اقتناص التحميلات التلقائي من المتصفحات" IsChecked="True" Margin="0,0,0,8" FontWeight="SemiBold"/>
                        <CheckBox x:Name="ShowVideoPanelCheckBox" Content="إظهار لوحة تحميل الفيديو العائمة فوق المشغلات في صفحات الويب" IsChecked="True" Margin="0,0,0,14" FontWeight="SemiBold"/>

                        <GroupBox Header="امتدادات الملفات المراد اقتناصها وتحميلها تلقائياً" Margin="0,0,0,12">
                            <StackPanel Margin="6">
                                <TextBlock Text="اكتب الامتدادات مفصولة بفواصل (مثل IDM):" FontSize="11" Foreground="#555" Margin="0,0,0,4"/>
                                <TextBox x:Name="ExtensionsTextBox" Height="45" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="قائمة المواقع المستثناة / قائمة التجاهل (Exceptions List)">
                            <StackPanel Margin="6">
                                <TextBlock Text="المواقع التي لا ترغب باقتناص أي تحميلات منها (مفصولة بفواصل):" FontSize="11" Foreground="#555" Margin="0,0,0,4"/>
                                <TextBox x:Name="IgnoredSitesTextBox" Height="45" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="حول البرنامج">
                <StackPanel Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Ammar DM" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="الإصدار: 1.0" Foreground="#555" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="المطور: عمار الصميدعي" Foreground="#1565C0" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="محرك تحميل متوازي متعدد الخيوط" Foreground="#777" FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="حفظ" Width="80" Height="26" Margin="0,0,8,0" Click="SaveBtn_Click"/>
            <Button Content="إلغاء الأمر" Width="90" Height="26" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
