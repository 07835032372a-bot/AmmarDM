<Window x:Class="AmmarDM.UI.Views.DuplicateDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ammar DM - هذا الرابط موجود بالفعل"
        Height="210" Width="440"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F5F5F5"
        ResizeMode="NoResize">

    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="⚠️" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="هذا الملف موجود بالفعل في قائمة التحميلات!" FontWeight="Bold" FontSize="13" Foreground="#B71C1C"/>
                <TextBlock x:Name="FileNameText" Text="filename.ext" FontSize="11" Foreground="#424242" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="يرجى اختيار الإجراء المطلوب تنفيذه:" FontSize="12" Foreground="#333" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ResumeBtn" Content="استئناف التحميل" Width="110" Height="28" Margin="0,0,8,0" FontWeight="SemiBold" Click="ResumeBtn_Click"/>
            <Button x:Name="OverwriteBtn" Content="إعادة التحميل من البداية" Width="140" Height="28" Margin="0,0,8,0" Click="OverwriteBtn_Click"/>
            <Button x:Name="CancelBtn" Content="إلغاء الأمر" Width="85" Height="28" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
